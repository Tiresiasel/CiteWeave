# ============================================================
# CiteWeave — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env_template .env
# ============================================================
#
# ------------------------------------------------------
# Research Agent / Installation State
# ------------------------------------------------------
# These values are normally written by scripts/apply_install_choices.py.
# The Research Agent is the AI runtime that installs CiteWeave, schedules
# sync, and organizes future literature queries.
#
# Supported examples:
#   OpenClaw
#   Codex
#   Claude Code
#   Others
#
# CITEWEAVE_RESEARCH_AGENT=Codex
# CITEWEAVE_QUERY_ORCHESTRATION=agent_managed

# ------------------------------------------------------
# LLM Provider Mode
# ------------------------------------------------------
# Choose one of three modes:
#
#   openclaw  — Route all LLM calls through the local OpenClaw gateway.
#               No separate OpenAI key needed.
#               This is the recommended mode when running inside your
#               OpenClaw workflow (the gateway is already running locally).
#
#   openai    — Direct calls to the OpenAI API. Requires a real API key.
#               Set OPENAI_API_KEY below (or CITEWEAVE_LLM_API_KEY).
#
#   ollama    — Route to a local Ollama instance.
#               Set CITEWEAVE_LLM_MODEL and CITEWEAVE_LLM_API_BASE.
#
CITEWEAVE_LLM_PROVIDER=openclaw

# Model used by the OpenAI-compatible client.
# In openclaw mode this is an OpenClaw agent target, not a raw provider model.
# Defaults to openclaw/default if left empty.
CITEWEAVE_LLM_MODEL=openclaw/default

# Optional backend provider/model override for OpenClaw.
# This is sent as the x-openclaw-model header. Leave empty to use the
# gateway agent's configured default model.
# CITEWEAVE_OPENCLAW_BACKEND_MODEL=openai-codex/gpt-5.4

# API base URL (only needed for openclaw and ollama modes).
# For openclaw mode the default is http://localhost:18789/v1 — change only
# if your OpenClaw gateway runs elsewhere (e.g. remote VPS).
CITEWEAVE_LLM_API_BASE=

# API key. For openclaw mode this can be any placeholder string.
# For openai mode set your real OpenAI key here or as OPENAI_API_KEY.
CITEWEAVE_LLM_API_KEY=not-needed-for-openclaw

# Conventional OpenAI key fallback.
# - Used for LLM calls when CITEWEAVE_LLM_PROVIDER=openai.
# - Also used for OpenAI embeddings when CITEWEAVE_EMBEDDING_PROVIDER=openai.
# OPENAI_API_KEY=your-openai-api-key

# ------------------------------------------------------
# Embeddings / Vector Indexing
# ------------------------------------------------------
# Embeddings are separate from LLM calls.
# Default: local SentenceTransformers embeddings.
# Optional: OpenAI embeddings for higher-quality remote vector indexing.
#
# Supported values:
#   local  — SentenceTransformers profiles such as BGE large or MiniLM
#   openai — OpenAI embeddings, requires OPENAI_API_KEY or CITEWEAVE_EMBEDDING_API_KEY
#
CITEWEAVE_EMBEDDING_PROVIDER=local
CITEWEAVE_EMBEDDING_MODEL=all-MiniLM-L6-v2
# CITEWEAVE_EMBEDDING_PROFILE=mini_l6_compat
# CITEWEAVE_EMBEDDING_DIMENSIONS=384
# CITEWEAVE_EMBEDDING_API_KEY=your-openai-api-key

# ------------------------------------------------------
# Neo4j Database
# ------------------------------------------------------
# Set a local password before starting Neo4j; never reuse the template value in production.
CITEWEAVE_NEO4J_PASSWORD=change-me-local-only

# ------------------------------------------------------
# Literature Data Source
# ------------------------------------------------------
# Point this at a reference-manager data directory or a plain PDF folder.
# The generic AI-facing sync entrypoint is scripts/sync_literature_pdfs.py.
# Zotero compatibility is kept through CITEWEAVE_ZOTERO_LIBRARY_DIR and
# scripts/sync_zotero_pdfs.py.
# CITEWEAVE_REFERENCE_MANAGER=zotero
# CITEWEAVE_LITERATURE_SOURCE_DIR=/path/to/library-or-pdf-folder
# CITEWEAVE_ZOTERO_LIBRARY_DIR=/path/to/Zotero

# ------------------------------------------------------
# Application Environment
# ------------------------------------------------------
# 'production' = clean output, minimal logs (default)
# 'development' = verbose debug logging
CITEWEAVE_ENV=production
