# ============================================================
# CiteWeave — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env_template .env
# ============================================================
#
# ------------------------------------------------------
# LLM Provider Mode
# ------------------------------------------------------
# Choose one of three modes:
#
#   openclaw  — Route all LLM calls through the local OpenClaw gateway.
#               No separate OpenAI key needed.
#               This is the recommended mode when running inside your
#               OpenClaw workflow (the gateway is already running locally).
#
#   openai    — Direct calls to the OpenAI API. Requires a real API key.
#               Set OPENAI_API_KEY below (or CITEWEAVE_LLM_API_KEY).
#
#   ollama    — Route to a local Ollama instance.
#               Set CITEWEAVE_LLM_MODEL and CITEWEAVE_LLM_API_BASE.
#
CITEWEAVE_LLM_PROVIDER=openclaw

# Model used when CITEWEAVE_LLM_PROVIDER=openclaw
# Defaults to openai-codex/gpt-5.4 if left empty.
CITEWEAVE_LLM_MODEL=

# API base URL (only needed for openclaw and ollama modes).
# For openclaw mode the default is http://localhost:18789/v1 — change only
# if your OpenClaw gateway runs elsewhere (e.g. remote VPS).
CITEWEAVE_LLM_API_BASE=

# API key. For openclaw mode this can be any placeholder string.
# For openai mode set your real OpenAI key here or as OPENAI_API_KEY.
CITEWEAVE_LLM_API_KEY=not-needed-for-openclaw

# Conventional OpenAI key fallback (used when CITEWEAVE_LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-...yourkey...

# ------------------------------------------------------
# Neo4j Database
# ------------------------------------------------------
# Default password is "0xC1735" — change before production use.
CITEWEAVE_NEO4J_PASSWORD=0xC1735

# ------------------------------------------------------
# Application Environment
# ------------------------------------------------------
# 'production' = clean output, minimal logs (default)
# 'development' = verbose debug logging
CITEWEAVE_ENV=production
